{
  auto_https off
  admin off
}
http://{$LIVE_VIEW_GATEWAY_HOST} {
  handle /.well-known/acme-challenge/* {
    root * /var/www/acme
    file_server
  }
  handle {
    respond "Unavailable" 403
  }
}
https://{$LIVE_VIEW_GATEWAY_HOST} {
  tls /certificates/live/{$LIVE_VIEW_GATEWAY_HOST}/fullchain.pem /certificates/live/{$LIVE_VIEW_GATEWAY_HOST}/privkey.pem
  @health {
    header Authorization "Bearer {$LIVE_VIEW_GATEWAY_SECRET}"
    method GET
    path /_infro/health
  }
  handle @health {
    header Cache-Control "private, no-store"
    respond "INFRO relay guard ready" 200
  }
  @authorized {
    header Authorization "Bearer {$LIVE_VIEW_GATEWAY_SECRET}"
    method GET
    path_regexp media ^/[a-f0-9]{32}/[A-Za-z0-9_-]{1,160}\.(m3u8|ts|mp4|m4s)$
  }
  handle @authorized {
    header Cache-Control "private, no-store"
    reverse_proxy media:8888 {
      header_up Authorization "Bearer infro-reader:{$LIVE_VIEW_GATEWAY_SECRET}"
    }
  }
  handle {
    respond "Unavailable" 403
  }
}
# Internal only; compose never publishes 8081.
:8081 {
  @auth {
    path /auth
    method POST
  }
  handle @auth {
    rewrite * /api/live-view/relay/auth
    reverse_proxy https://ir.sa {
      header_up Host ir.sa
      header_up X-Infro-Relay-Secret "{$LIVE_VIEW_RELAY_AUTH_SECRET}"
    }
  }
  handle {
    respond "Unavailable" 403
  }
}
