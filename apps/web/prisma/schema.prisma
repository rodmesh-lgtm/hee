generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())
  name String
  email String @unique
  passwordHash String?
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  sessions Session[]
  businesses Business[]
  authIdentities AuthIdentity[]
  createdAccessCodes SubscriptionAccessCode[] @relation("AccessCodeCreator")
  redeemedAccessGrants SubscriptionAccessGrant[] @relation("AccessGrantRedeemer")
  whatsappEmbeddedSignupSessions WhatsAppEmbeddedSignupSession[]
  businessMemberships BusinessMember[]
  whatsappAuditLogs WhatsAppAuditLog[]
  @@index([email])
  @@index([emailVerifiedAt])
  @@index([deletedAt])
}

model AuthIdentity {
  id String @id @default(uuid())
  userId String
  provider String
  providerSubject String
  providerEmail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerSubject])
  @@index([userId])
  @@index([providerEmail])
}

model OAuthState {
  id String @id @default(uuid())
  state String @unique
  provider String
  nonce String
  codeVerifier String?
  redirectTo String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([provider])
  @@index([expiresAt])
}

model Session {
  id String @id @default(uuid())
  token String @unique
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model BusinessPlan {
  id String @id @default(uuid())
  code String @unique
  name String
  monthlyPrice Int
  productLimit Int
  aiEnabled Boolean @default(false)
  onlinePay Boolean @default(false)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  businesses Business[]
  subscriptions Subscription[]
  billingPayments BillingPayment[]
  accessCodes SubscriptionAccessCode[]
  accessGrants SubscriptionAccessGrant[]
}

model Business {
  id String @id @default(uuid())
  ownerId String
  planId String?
  name String
  nameEn String?
  slug String @unique
  businessType String
  description String?
  shortDescription String?
  entityType String?
  businessCategory String?
  onboardingCompleted Boolean @default(false)
  onboardingStep String? @default("account_created")
  email String?
  website String?
  country String?
  city String?
  district String?
  googleMapsLink String?
  whatsapp String?
  phone String?
  address String?
  logoUrl String?
  coverUrl String?
  primaryColor String @default("#5D43EF")
  secondaryColor String?
  buttonColor String?
  buttonStyle String? @default("rounded")
  cardStyle String? @default("glass")
  pageModules Json?
  workingHours String?
  deliveryAvailable Boolean @default(false)
  bookingAvailable Boolean @default(false)
  acceptOnlineOrders Boolean @default(false)
  xUrl String?
  instagramUrl String?
  snapchatUrl String?
  tiktokUrl String?
  facebookUrl String?
  metaTitle String?
  metaDescription String?
  isVerified Boolean @default(false)
  isPublished Boolean @default(false)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  digitalDestinationType String?
  companyProfileUrl String?
  companyProfileTitle String?
  licenseNumber String?
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  plan BusinessPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  products Product[]
  categories Category[]
  offers Offer[]
  services Service[]
  customers Customer[]
  orders Order[]
  bookings Booking[]
  openingHours WorkingHours[]
  socialLinks SocialLink[]
  galleryItems GalleryItem[]
  subscriptions Subscription[]
  billingPaymentMethods BillingPaymentMethod[]
  billingPayments BillingPayment[]
  businessStoreOrders BusinessStoreOrder[]
  accessGrants SubscriptionAccessGrant[]
  analytics AnalyticsEvent[]
  branches Branch[]
  departments Department[]
  contactPersons ContactPerson[]
  whatsappConnections WhatsAppConnection[]
  whatsappConsents WhatsAppConsent[]
  whatsappWebhookEvents WhatsAppWebhookEvent[]
  whatsappConversations WhatsAppConversation[]
  whatsappMessages WhatsAppMessage[]
  whatsappContacts WhatsAppContact[]
  whatsappContactTags WhatsAppContactTag[]
  whatsappSegments WhatsAppSegment[]
  whatsappContactImports WhatsAppContactImport[]
  whatsappTemplates WhatsAppTemplate[]
  whatsappCampaigns WhatsAppCampaign[]
  whatsappDeliveryJobs WhatsAppDeliveryJob[]
  whatsappRateBuckets WhatsAppSendRateBucket[]
  whatsappReplyJobs WhatsAppReplyJob[]
  whatsappEmbeddedSignupSessions WhatsAppEmbeddedSignupSession[]
  members BusinessMember[]
  whatsappAuditLogs WhatsAppAuditLog[]
  @@index([ownerId])
  @@index([planId])
  @@index([slug])
  @@index([isPublished])
  @@index([deletedAt])
}

model Category {
  id String @id @default(uuid())
  businessId String
  name String
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  products Product[]
  @@unique([businessId, name])
  @@index([businessId])
  @@index([sortOrder])
}

model Product {
  id String @id @default(uuid())
  businessId String
  categoryId String?
  name String
  description String?
  unit String?
  price Int
  oldPrice Int?
  imageUrl String?
  isActive Boolean @default(true)
  featured Boolean @default(false)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]
  @@index([businessId])
  @@index([categoryId])
  @@index([isActive])
  @@index([sortOrder])
}

model Customer {
  id String @id @default(uuid())
  businessId String
  name String
  phone String
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  orders Order[]
  bookings Booking[]
  whatsappConsents WhatsAppConsent[]
  @@index([businessId])
  @@index([phone])
}

model Order {
  id String @id @default(uuid())
  businessId String
  customerId String
  notes String?
  orderType String @default("استلام")
  total Int @default(0)
  status String @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items OrderItem[]
  @@index([businessId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id String @id @default(uuid())
  orderId String
  productId String?
  name String
  unitPrice Int
  quantity Int @default(1)
  total Int @default(0)
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([orderId])
  @@index([productId])
}

model Offer {
  id String @id @default(uuid())
  businessId String
  title String
  description String?
  discountLabel String?
  imageUrl String?
  startsAt DateTime?
  endsAt DateTime?
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@index([businessId])
  @@index([isActive])
  @@index([sortOrder])
  @@index([startsAt, endsAt])
}

model Service {
  id String @id @default(uuid())
  businessId String
  name String
  description String?
  price Int
  durationMinutes Int?
  imageUrl String?
  bookingEnabled Boolean @default(true)
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  bookings Booking[]
  @@index([businessId])
  @@index([isActive])
  @@index([sortOrder])
}

model Booking {
  id String @id @default(uuid())
  businessId String
  customerId String
  serviceId String?
  bookingDate String
  bookingTime String
  notes String?
  status String @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  @@index([businessId])
  @@index([customerId])
  @@index([serviceId])
  @@index([bookingDate])
}

model WorkingHours {
  id String @id @default(uuid())
  businessId String
  dayOfWeek Int
  opensAt String?
  closesAt String?
  secondOpensAt String?
  secondClosesAt String?
  isClosed Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@unique([businessId, dayOfWeek])
  @@index([businessId])
  @@index([dayOfWeek])
}

model GalleryItem {
  id String @id @default(uuid())
  businessId String
  imageUrl String
  caption String?
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@index([businessId])
  @@index([sortOrder])
  @@index([isActive])
}

model SocialLink {
  id String @id @default(uuid())
  businessId String
  platform String
  url String
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@unique([businessId, platform])
  @@index([businessId])
  @@index([sortOrder])
  @@index([isActive])
}

model Subscription {
  id String @id @default(uuid())
  businessId String
  planId String
  status String @default("active")
  provider String?
  providerCustomerId String?
  providerSubscriptionId String?
  autoRenew Boolean @default(false)
  providerReference String?
  paymentMethodId String?
  startsAt DateTime @default(now())
  endsAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  plan BusinessPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  paymentMethod BillingPaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  billingPayments BillingPayment[]
  accessGrants SubscriptionAccessGrant[]
  @@index([businessId])
  @@index([planId])
  @@index([status])
  @@index([paymentMethodId])
}

model SubscriptionAccessCode {
  id String @id @default(uuid())
  codeHash String @unique
  label String?
  planId String
  isActive Boolean @default(true)
  maxRedemptions Int?
  redemptionCount Int @default(0)
  expiresAt DateTime?
  createdByUserId String
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plan BusinessPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy User @relation("AccessCodeCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  grants SubscriptionAccessGrant[]
  @@index([isActive, expiresAt], map: "SubscriptionAccessCode_active_idx")
}

model SubscriptionAccessGrant {
  id String @id @default(uuid())
  codeId String
  businessId String
  planId String
  subscriptionId String
  redeemedByUserId String
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  code SubscriptionAccessCode @relation(fields: [codeId], references: [id], onDelete: Restrict)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  plan BusinessPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  redeemedBy User @relation("AccessGrantRedeemer", fields: [redeemedByUserId], references: [id], onDelete: Restrict)
  @@unique([codeId, businessId])
  @@index([businessId, revokedAt], map: "SubscriptionAccessGrant_business_active_idx")
  @@index([subscriptionId], map: "SubscriptionAccessGrant_subscription_idx")
}

model BillingPaymentMethod {
  id String @id @default(uuid())
  businessId String
  provider String @default("moyasar")
  encryptedToken String
  brand String?
  last4 String?
  status String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]
  @@index([businessId])
}

model BillingPayment {
  id String @id @default(uuid())
  businessId String
  planId String
  subscriptionId String?
  provider String @default("moyasar")
  providerPaymentId String? @unique(map: "BillingPayment_provider_payment_unique")
  providerGivenId String @unique(map: "BillingPayment_provider_given_unique")
  kind String @default("initial")
  amount Int
  currency String @default("SAR")
  status String @default("created")
  attempt Int @default(1)
  nextRetryAt DateTime?
  paidAt DateTime?
  receiptSellerLegalName String?
  receiptSellerAddress String?
  receiptTaxStatus String?
  receiptNetAmount Int?
  receiptVatAmount Int?
  receiptIssuedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  plan BusinessPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  webhookEvents BillingWebhookEvent[]
  @@index([businessId, createdAt])
  @@index([status, nextRetryAt])
}

model BillingWebhookEvent {
  id String @id @default(uuid())
  provider String @default("moyasar")
  providerEventId String
  eventType String
  billingPaymentId String?
  createdAt DateTime @default(now())
  processedAt DateTime?
  billingPayment BillingPayment? @relation(fields: [billingPaymentId], references: [id], onDelete: SetNull)
  @@unique([provider, providerEventId], map: "BillingWebhookEvent_provider_event_unique")
  @@index([createdAt])
}

model BillingOperationsHeartbeat {
  id String @id
  lastSucceededAt DateTime
  releaseSha String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessStoreOrder {
  id String @id @default(uuid())
  businessId String
  idempotencyKey String
  status String @default("draft")
  paymentStatus String @default("unpaid")
  currency String @default("SAR")
  subtotal Int @default(0)
  shippingAmount Int @default(0)
  vatAmount Int @default(0)
  total Int @default(0)
  businessNameSnapshot String
  businessSlugSnapshot String
  publicUrlSnapshot String
  logoUrlSnapshot String?
  primaryColorSnapshot String
  secondaryColorSnapshot String?
  identitySnapshot Json
  customizationSnapshot Json
  shippingName String?
  shippingPhone String?
  shippingEmail String?
  shippingAddressLine1 String?
  shippingAddressLine2 String?
  shippingCity String?
  shippingDistrict String?
  shippingPostalCode String?
  shippingCountry String @default("SA")
  paymentProvider String?
  providerPaymentId String?
  submittedAt DateTime?
  paidAt DateTime?
  cancelledAt DateTime?
  fulfilledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  items BusinessStoreOrderItem[]
  @@unique([businessId, idempotencyKey], map: "BusinessStoreOrder_business_idempotency_unique")
  @@unique([paymentProvider, providerPaymentId], map: "BusinessStoreOrder_provider_payment_unique")
  @@index([businessId, createdAt], map: "BusinessStoreOrder_business_created_idx")
  @@index([status, createdAt], map: "BusinessStoreOrder_status_created_idx")
  @@index([paymentStatus, createdAt], map: "BusinessStoreOrder_payment_status_created_idx")
}

model BusinessStoreOrderItem {
  id String @id @default(uuid())
  orderId String
  sku String
  nameSnapshot String
  descriptionSnapshot String?
  unitPrice Int
  quantity Int @default(1)
  lineTotal Int
  customizationSnapshot Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order BusinessStoreOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([orderId], map: "BusinessStoreOrderItem_order_idx")
}

model AnalyticsEvent {
  id String @id @default(uuid())
  businessId String
  eventType String
  metadata Json?
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@index([businessId])
  @@index([eventType])
  @@index([createdAt])
}

model Branch {
  id String @id @default(uuid())
  businessId String
  name String
  city String?
  district String?
  address String?
  phone String?
  whatsapp String?
  googleMapsLink String?
  isMain Boolean @default(false)
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  contacts ContactPerson[]
  @@index([businessId])
  @@index([isActive])
  @@index([sortOrder])
}

model Department {
  id String @id @default(uuid())
  businessId String
  name String
  description String?
  icon String?
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  contacts ContactPerson[]
  @@index([businessId])
  @@index([isActive])
  @@index([sortOrder])
}

model ContactPerson {
  id String @id @default(uuid())
  businessId String
  departmentId String?
  branchId String?
  name String
  jobTitle String?
  phone String?
  whatsapp String?
  email String?
  imageUrl String?
  isPrimary Boolean @default(false)
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  @@index([businessId])
  @@index([departmentId])
  @@index([branchId])
  @@index([isActive])
  @@index([sortOrder])
}

model WhatsAppConnection {
  id String @id @default(uuid())
  businessId String
  provider String @default("meta")
  status String @default("pending")
  wabaId String
  phoneNumberId String
  displayPhoneNumber String?
  verifiedName String?
  credentialEnvelope Json
  connectedAt DateTime?
  disabledAt DateTime?
  lastErrorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  templates WhatsAppTemplate[]
  campaigns WhatsAppCampaign[]
  deliveryJobs WhatsAppDeliveryJob[]
  rateBuckets WhatsAppSendRateBucket[]
  replyJobs WhatsAppReplyJob[]
  @@unique([businessId, provider], map: "WhatsAppConnection_business_provider_unique")
  @@unique([provider, wabaId], map: "WhatsAppConnection_provider_waba_unique")
  @@unique([provider, phoneNumberId], map: "WhatsAppConnection_provider_phone_unique")
  @@unique([id, businessId], map: "WhatsAppConnection_id_business_unique")
  @@unique([id, businessId, phoneNumberId], map: "WhatsAppConnection_id_business_phone_unique")
  @@index([businessId, status], map: "WhatsAppConnection_business_status_idx")
}

model WhatsAppEmbeddedSignupSession {
  id String @id @default(uuid())
  businessId String
  initiatedByUserId String
  stateDigest String @unique
  status String @default("created")
  wabaId String?
  phoneNumberId String?
  credentialEnvelope Json?
  expiresAt DateTime
  consumedAt DateTime?
  lastErrorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  initiatedBy User @relation(fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  @@unique([id, businessId], map: "WhatsAppEmbeddedSignupSession_id_business_unique")
  @@index([businessId, status, expiresAt], map: "WhatsAppEmbeddedSignupSession_business_status_expiry_idx")
  @@index([initiatedByUserId, createdAt], map: "WhatsAppEmbeddedSignupSession_user_created_idx")
}

model BusinessMember {
  id String @id @default(uuid())
  businessId String
  userId String
  role String
  status String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([businessId, userId], map: "BusinessMember_business_user_unique")
  @@index([userId, status], map: "BusinessMember_user_status_idx")
  @@index([businessId, role, status], map: "BusinessMember_business_role_status_idx")
}

model WhatsAppAuditLog {
  id String @id @default(uuid())
  businessId String
  actorUserId String?
  actorType String @default("user")
  action String
  targetType String
  targetId String?
  outcome String
  metadata Json?
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  @@index([businessId, createdAt], map: "WhatsAppAuditLog_business_created_idx")
  @@index([businessId, action, createdAt], map: "WhatsAppAuditLog_business_action_created_idx")
  @@index([actorUserId, createdAt], map: "WhatsAppAuditLog_actor_created_idx")
}

model WhatsAppConsent {
  id String @id @default(uuid())
  businessId String
  customerId String?
  phoneE164 String
  source String
  evidence String
  consentedAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  @@unique([businessId, phoneE164], map: "WhatsAppConsent_business_phone_unique")
  @@index([businessId, revokedAt], map: "WhatsAppConsent_business_active_idx")
  @@index([customerId], map: "WhatsAppConsent_customer_idx")
}

model WhatsAppWebhookEvent {
  id String @id @default(uuid())
  businessId String?
  provider String @default("meta")
  providerEventId String
  wabaId String?
  phoneNumberId String?
  eventType String
  payload Json
  receivedAt DateTime @default(now())
  processedAt DateTime?
  processingError String?
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  @@unique([provider, providerEventId], map: "WhatsAppWebhookEvent_provider_event_unique")
  @@index([businessId, receivedAt], map: "WhatsAppWebhookEvent_business_received_idx")
  @@index([phoneNumberId, receivedAt], map: "WhatsAppWebhookEvent_phone_received_idx")
  @@index([processedAt, receivedAt], map: "WhatsAppWebhookEvent_processing_idx")
}

model WhatsAppConversation {
  id String @id @default(uuid())
  businessId String
  phoneNumberId String
  customerPhoneE164 String
  customerDisplayName String?
  lastMessageAt DateTime?
  lastInboundAt DateTime?
  lastOutboundAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  messages WhatsAppMessage[]
  replyJobs WhatsAppReplyJob[]
  @@unique([businessId, phoneNumberId, customerPhoneE164], map: "WhatsAppConversation_tenant_phone_unique")
  @@unique([id, businessId], map: "WhatsAppConversation_id_business_unique")
  @@unique([id, businessId, phoneNumberId], map: "WhatsAppConversation_id_business_phone_unique")
  @@index([businessId, lastMessageAt], map: "WhatsAppConversation_business_last_message_idx")
}

model WhatsAppMessage {
  id String @id @default(uuid())
  businessId String
  conversationId String
  provider String @default("meta")
  providerMessageId String
  direction String
  messageType String
  status String
  textBody String?
  payload Json?
  errorCode String?
  errorMessage String?
  providerTimestamp DateTime?
  sentAt DateTime?
  deliveredAt DateTime?
  readAt DateTime?
  failedAt DateTime?
  createdAt DateTime @default(now())
