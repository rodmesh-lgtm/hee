generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

generator clientEdge {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String?
  name         String
  image        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  businesses   Business[]
  sessions     Session[]
  authIdentities AuthIdentity[]
}

model AuthIdentity {
  id              String   @id @default(uuid())
  userId          String
  provider        String
  providerSubject String
  providerEmail   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerSubject])
  @@index([userId])
  @@index([providerEmail])
}

model OAuthState {
  id           String   @id @default(uuid())
  stateHash    String   @unique
  provider     String
  codeVerifier String?
  returnTo     String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  @@index([provider])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model BusinessPlan {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  monthlyPrice  Decimal  @db.Decimal(10, 2)
  productLimit  Int      @default(3)
  aiEnabled     Boolean  @default(false)
  onlinePay     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  businesses    Business[]
  subscriptions Subscription[]
}

model Business {
  id                  String    @id @default(uuid())
  ownerId             String
  planId              String?
  name                String
  nameEn              String?
  slug                String    @unique
  businessType        String
  description         String?
  shortDescription    String?
  entityType          String?
  businessCategory    String?
  onboardingCompleted Boolean   @default(false)
  onboardingStep      String?   @default("account_created")
  email               String?
  website             String?
  country             String?
  city                String?
  district             String?
  googleMapsLink      String?
  whatsapp            String?
  phone                String?
  address             String?
  logoUrl             String?
  coverUrl            String?
  primaryColor        String    @default("#5D43EF")
  secondaryColor      String?
  buttonColor         String?
  buttonStyle         String?   @default("rounded")
  cardStyle           String?   @default("glass")
  pageModules         Json?
  workingHours        String?
  deliveryAvailable   Boolean   @default(false)
  bookingAvailable    Boolean   @default(false)
  acceptOnlineOrders  Boolean   @default(false)
  xUrl                String?
  instagramUrl        String?
  snapchatUrl         String?
  tiktokUrl           String?
  facebookUrl         String?
  metaTitle           String?
  metaDescription     String?
  isVerified          Boolean   @default(false)
  isPublished         Boolean   @default(false)
  publishedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  digitalDestinationType String?
  companyProfileUrl      String?
  companyProfileTitle    String?
  licenseNumber          String?

  owner         User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  plan          BusinessPlan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  products      Product[]
  categories    Category[]
  offers        Offer[]
  services      Service[]
  customers     Customer[]
  orders        Order[]
  bookings      Booking[]
  openingHours  WorkingHours[]
  socialLinks   SocialLink[]
  galleryItems  GalleryItem[]
  subscriptions Subscription[]
  analytics     AnalyticsEvent[]
  branches       Branch[]
  departments    Department[]
  contactPersons ContactPerson[]
  slugAliases    BusinessSlugAlias[]

  @@index([ownerId])
  @@index([planId])
  @@index([slug])
  @@index([isPublished])
  @@index([deletedAt])
}

model BusinessSlugAlias {
  id         String   @id @default(uuid())
  businessId String
  slug       String   @unique
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId])
}

model Category {
  id String @id @default(uuid())
  businessId String
  name String
  slug String
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]
  @@unique([businessId, slug])
  @@index([businessId])
}

model Product {
  id String @id @default(uuid())
  businessId String
  categoryId String?
  name String
  description String?
  price Decimal @db.Decimal(10,2)
  compareAtPrice Decimal? @db.Decimal(10,2)
  imageUrl String?
  sku String?
  stock Int @default(0)
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]
  @@index([businessId])
  @@index([categoryId])
}

model Customer {
  id String @id @default(uuid())
  businessId String
  name String
  email String?
  phone String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders Order[]
  bookings Booking[]
  @@index([businessId])
}

model Order {
  id String @id @default(uuid())
  businessId String
  customerId String?
  status String @default("pending")
  total Decimal @db.Decimal(10,2)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items OrderItem[]
  @@index([businessId])
  @@index([customerId])
}

model OrderItem {
  id String @id @default(uuid())
  orderId String
  productId String?
  name String
  quantity Int
  unitPrice Decimal @db.Decimal(10,2)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([orderId])
  @@index([productId])
}

model Offer {
  id String @id @default(uuid())
  businessId String
  title String
  description String?
  imageUrl String?
  startsAt DateTime?
  endsAt DateTime?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId])
}

model Service {
  id String @id @default(uuid())
  businessId String
  name String
  description String?
  price Decimal? @db.Decimal(10,2)
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings Booking[]
  @@index([businessId])
}

model Booking {
  id String @id @default(uuid())
  businessId String
  customerId String?
  serviceId String?
  startsAt DateTime
  status String @default("pending")
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  @@index([businessId])
  @@index([customerId])
  @@index([serviceId])
}

model WorkingHours {
  id String @id @default(uuid())
  businessId String
  dayOfWeek Int
  opensAt String?
  closesAt String?
  isClosed Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@unique([businessId, dayOfWeek])
}

model GalleryItem {
  id String @id @default(uuid())
  businessId String
  imageUrl String
  caption String?
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId])
}

model SocialLink {
  id String @id @default(uuid())
  businessId String
  platform String
  url String
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId])
}

model Subscription {
  id String @id @default(uuid())
  businessId String
  planId String
  status String @default("active")
  startsAt DateTime @default(now())
  endsAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan BusinessPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  @@index([businessId])
  @@index([planId])
}

model AnalyticsEvent {
  id String @id @default(uuid())
  businessId String
  type String
  path String?
  metadata Json?
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId])
  @@index([createdAt])
}

model Branch {
  id String @id @default(uuid())
  businessId String
  name String
  city String?
  district String?
  address String?
  googleMapsLink String?
  phone String?
  whatsapp String?
  isMain Boolean @default(false)
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contacts ContactPerson[]
  @@index([businessId])
}

model Department {
  id String @id @default(uuid())
  businessId String
  name String
  description String?
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contacts ContactPerson[]
  @@index([businessId])
}

model ContactPerson {
  id String @id @default(uuid())
  businessId String
  departmentId String
  branchId String?
  name String
  jobTitle String?
  phone String?
  whatsapp String?
  email String?
  isPrimary Boolean @default(false)
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  @@index([businessId])
  @@index([departmentId])
  @@index([branchId])
}

model StoredObject {
  id String @id @default(uuid())
  storageKey String @unique
  backend String
  contentType String
  sizeBytes Int
  checksum String?
  data Bytes?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([backend])
  @@index([createdAt])
}

model PublicWriteRateLimit {
  id String @id @default(uuid())
  key String
  bucketStart DateTime
  count Int @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([key, bucketStart])
  @@index([expiresAt])
}
