generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  sessions       Session[]
  businesses     Business[]
  authIdentities AuthIdentity[]

  @@index([email])
  @@index([deletedAt])
}

model AuthIdentity {
  id              String   @id @default(uuid())
  userId          String
  provider        String
  providerSubject String
  providerEmail   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@index([providerEmail])
}

model OAuthState {
  id           String   @id @default(uuid())
  state        String   @unique
  provider     String
  nonce        String
  codeVerifier String?
  redirectTo   String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([provider])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model BusinessPlan {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  monthlyPrice Int
  productLimit Int
  aiEnabled    Boolean  @default(false)
  onlinePay    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  businesses    Business[]
  subscriptions Subscription[]
}

model Business {
  id                  String    @id @default(uuid())
  ownerId             String
  planId              String?
  name                String
  nameEn              String?
  slug                String    @unique
  businessType        String
  description         String?
  shortDescription    String?
  entityType          String?
  businessCategory    String?
  onboardingCompleted Boolean   @default(false)
  onboardingStep      String?   @default("account_created")
  email               String?
  website             String?
  country             String?
  city                String?
  district             String?
  googleMapsLink      String?
  whatsapp            String?
  phone                String?
  address             String?
  logoUrl             String?
  coverUrl            String?
  primaryColor        String    @default("#5D43EF")
  secondaryColor      String?
  buttonColor         String?
  buttonStyle         String?   @default("rounded")
  cardStyle           String?   @default("glass")
  pageModules         Json?
  workingHours        String?
  deliveryAvailable   Boolean   @default(false)
  bookingAvailable    Boolean   @default(false)
  acceptOnlineOrders  Boolean   @default(false)
  xUrl                String?
  instagramUrl        String?
  snapchatUrl         String?
  tiktokUrl            String?
  facebookUrl         String?
  metaTitle           String?
  metaDescription     String?
  isVerified          Boolean   @default(false)
  isPublished         Boolean   @default(false)
  publishedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  digitalDestinationType String?
  companyProfileUrl      String?
  companyProfileTitle    String?
  licenseNumber          String?

  owner         User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  plan          BusinessPlan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  products      Product[]
  categories    Category[]
  offers        Offer[]
  services      Service[]
  customers     Customer[]
  orders        Order[]
  bookings      Booking[]
  openingHours  WorkingHours[]
  socialLinks   SocialLink[]
  galleryItems  GalleryItem[]
  subscriptions Subscription[]
  analytics     AnalyticsEvent[]
  branches       Branch[]
  departments    Department[]
  contactPersons ContactPerson[]

  @@index([ownerId])
  @@index([planId])
  @@index([slug])
  @@index([isPublished])
  @@index([deletedAt])
}

model Category {
  id         String    @id @default(uuid())
  businessId String
  name       String
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([sortOrder])
}

model Product {
  id          String    @id @default(uuid())
  businessId  String
  categoryId  String?
  name        String
  description String?
  unit        String?
  price       Int
  oldPrice    Int?
  imageUrl    String?
  isActive    Boolean   @default(false)
  featured    Boolean   @default(false)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@index([businessId])
  @@index([categoryId])
  @@index([isActive])
  @@index([sortOrder])
}

model Customer {
  id         String   @id @default(uuid())
  businessId String
  name       String
  phone      String
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders   Order[]
  bookings Booking[]

  @@index([businessId])
  @@index([phone])
}

model Order {
  id         String   @id @default(uuid())
  businessId String
  customerId String
  notes      String?
  orderType  String   @default("استلام")
  total      Int      @default(0)
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    OrderItem[]

  @@index([businessId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String?
  name      String
  unitPrice Int
  quantity  Int      @default(1)
  total     Int      @default(0)
  createdAt DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Offer {
  id            String    @id @default(uuid())
  businessId    String
  title         String
  description   String?
  discountLabel String?
  imageUrl      String?
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([isActive])
  @@index([sortOrder])
  @@index([startsAt, endsAt])
}

model Service {
  id              String    @id @default(uuid())
  businessId      String
  name            String
  description     String?
  price           Int
  durationMinutes Int?
  imageUrl        String?
  bookingEnabled  Boolean   @default(true)
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([businessId])
  @@index([isActive])
  @@index([sortOrder])
}

model Booking {
  id          String   @id @default(uuid())
  businessId  String
  customerId  String
  serviceId   String?
  bookingDate String
  bookingTime String
  notes       String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([customerId])
  @@index([serviceId])
  @@index([bookingDate])
}

model WorkingHours {
  id             String   @id @default(uuid())
  businessId     String
  dayOfWeek      Int
  opensAt        String?
  closesAt       String?
  secondOpensAt  String?
  secondClosesAt String?
  isClosed       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
  @@index([dayOfWeek])
}

model GalleryItem {
  id         String   @id @default(uuid())
  businessId String
  imageUrl   String
  caption    String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([sortOrder])
  @@index([isActive])
}

model SocialLink {
  id         String   @id @default(uuid())
  businessId String
  platform   String
  url        String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, platform])
  @@index([businessId])
  @@index([sortOrder])
  @@index([isActive])
}

model Subscription {
  id         String   @id @default(uuid())
  businessId String
  planId     String
  status     String   @default("active")
  startsAt   DateTime @default(now())
  endsAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     BusinessPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([planId])
  @@index([status])
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  businessId String
  eventType  String
  metadata   Json?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([eventType])
  @@index([createdAt])
}

model Branch {
  id             String   @id @default(uuid())
  businessId     String
  name           String
  city           String?
  district       String?
  address        String?
  phone          String?
  whatsapp       String?
  googleMapsLink String?
  isMain         Boolean  @default(false)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contacts ContactPerson[]

  @@index([businessId])
  @@index([isActive])
  @@index([sortOrder])
}

model Department {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contacts ContactPerson[]

  @@index([businessId])
  @@index([isActive])
  @@index([sortOrder])
}

model ContactPerson {
  id           String   @id @default(uuid())
  businessId   String
  departmentId String?
  branchId     String?
  name         String
  jobTitle     String?
  phone        String?
  whatsapp     String?
  email        String?
  imageUrl     String?
  isPrimary    Boolean  @default(false)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([departmentId])
  @@index([branchId])
  @@index([isActive])
  @@index([sortOrder])
}

model StoredObject {
  id            String   @id @default(uuid())
  objectKey     String   @unique
  folder        String
  fileName      String
  mimeType      String
  size          Int
  storageDriver String   @default("database")
  data          Bytes?
  createdAt     DateTime @default(now())

  @@index([folder])
  @@index([storageDriver])
  @@index([createdAt])
}
