generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole { USER ADMIN }
model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String?
  name String
  role UserRole @default(USER)
  emailVerifiedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  businesses Business[]
  sessions Session[]
  authIdentities AuthIdentity[]
}
model Session {
  id String @id @default(uuid())
  token String @unique
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}
model AuthIdentity {
  id String @id @default(uuid())
  userId String
  provider String
  providerUserId String
  email String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerUserId])
  @@index([userId])
}
model OAuthState {
  id String @id @default(uuid())
  state String @unique
  provider String
  nonce String?
  redirectTo String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([provider])
  @@index([expiresAt])
}
model BusinessPlan {
  id String @id @default(uuid())
  code String @unique
  name String
  monthlyPrice Int @default(0)
  maxBranches Int @default(1)
  maxTeamMembers Int @default(1)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  businesses Business[]
  subscriptions Subscription[]
  billingPayments BillingPayment[]
}
model Business {
  id String @id @default(uuid())
  ownerId String
  planId String?
  name String
  slug String @unique
  description String?
  logoUrl String?
  coverUrl String?
  phone String?
  whatsapp String?
  email String?
  website String?
  city String?
  category String?
  isPublished Boolean @default(false)
  publishedAt DateTime?
  isVerified Boolean @default(false)
  onboardingCompleted Boolean @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  plan BusinessPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  services Service[]
  categories Category[]
  products Product[]
  customers Customer[]
  orders Order[]
  bookings Booking[]
  offers Offer[]
  galleryItems GalleryItem[]
  workingHours WorkingHours[]
  socialLinks SocialLink[]
  branches Branch[]
  departments Department[]
  contacts ContactPerson[]
  subscriptions Subscription[]
  billingPayments BillingPayment[]
  billingPaymentMethods BillingPaymentMethod[]
  analyticsEvents AnalyticsEvent[]
  @@index([ownerId])
  @@index([planId])
  @@index([isPublished])
  @@index([deletedAt])
}
model Service {
  id String @id @default(uuid())
  businessId String
  name String
  description String?
  price Int?
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@index([businessId])
  @@index([isActive])
  @@index([sortOrder])
}
model Category {
  id String @id @default(uuid())
  businessId String
  name String
  description String?
  imageUrl String?
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  products Product[]
  @@index([businessId])
  @@index([isActive])
  @@index([sortOrder])
}
model Product {
  id String @id @default(uuid())
  businessId String
  categoryId String?
  name String
  description String?
  price Int?
  imageUrl String?
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]
  @@index([businessId])
  @@index([categoryId])
  @@index([isActive])
  @@index([sortOrder])
}
model Customer {
  id String @id @default(uuid())
  businessId String
  name String
  phone String?
  email String?
  notes String?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  orders Order[]
  bookings Booking[]
  @@index([businessId])
}
model Order {
  id String @id @default(uuid())
  businessId String
  customerId String?
  status String @default("new")
  total Int @default(0)
  customerName String?
  customerPhone String?
  notes String?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items OrderItem[]
  @@index([businessId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}
model OrderItem {
  id String @id @default(uuid())
  orderId String
  productId String?
  name String
  quantity Int @default(1)
  unitPrice Int @default(0)
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([orderId])
  @@index([productId])
}
model Booking {
  id String @id @default(uuid())
  businessId String
  customerId String?
  customerName String
  customerPhone String?
  serviceName String?
  scheduledAt DateTime
  status String @default("new")
  notes String?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  @@index([businessId])
  @@index([customerId])
  @@index([scheduledAt])
  @@index([status])
}
model Offer {
  id String @id @default(uuid())
  businessId String
  title String
  description String?
  imageUrl String?
  startsAt DateTime?
  endsAt DateTime?
  isActive Boolean @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@index([businessId])
  @@index([isActive])
  @@index([endsAt])
}
model GalleryItem {
  id String @id @default(uuid())
  businessId String
  imageUrl String
  caption String?
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@index([businessId])
  @@index([sortOrder])
}
model WorkingHours {
  id String @id @default(uuid())
  businessId String
  dayOfWeek Int
  isClosed Boolean @default(false)
  opensAt String?
  closesAt String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@unique([businessId, dayOfWeek])
}
model SocialLink {
  id String @id @default(uuid())
  businessId String
  platform String
  url String
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@index([businessId])
  @@index([sortOrder])
}
model Subscription {
  id String @id @default(uuid())
  businessId String
  planId String
  status String @default("active")
  startsAt DateTime @default(now())
  endsAt DateTime?
  autoRenew Boolean @default(false)
  paymentMethodId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  plan BusinessPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  paymentMethod BillingPaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  billingPayments BillingPayment[]
  @@index([businessId])
  @@index([planId])
  @@index([status])
  @@index([endsAt])
}
model BillingPaymentMethod {
  id String @id @default(uuid())
  businessId String
  provider String @default("moyasar")
  providerTokenEncrypted String
  brand String?
  last4 String?
  status String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]
  @@index([businessId])
  @@index([status])
}
model BillingPayment {
  id String @id @default(uuid())
  businessId String
  planId String
  subscriptionId String?
  provider String @default("moyasar")
  providerPaymentId String?
  kind String
  status String @default("created")
  amount Int
  monthlyPrice Int
  retryCount Int @default(0)
  nextRetryAt DateTime?
  initiatedAt DateTime?
  providerCreatedAt DateTime?
  paidAt DateTime?
  failedAt DateTime?
  reversedAt DateTime?
  receiptSellerLegalName String?
  receiptSellerAddress String?
  receiptTaxStatus String?
  receiptNetAmount Int?
  receiptVatAmount Int?
  receiptIssuedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  plan BusinessPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  webhookEvents BillingWebhookEvent[]
  @@index([businessId, createdAt])
  @@index([status, nextRetryAt])
}
model BillingWebhookEvent {
  id String @id @default(uuid())
  provider String @default("moyasar")
  providerEventId String
  eventType String
  billingPaymentId String?
  attempts Int @default(0)
  processingStartedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  processedAt DateTime?
  billingPayment BillingPayment? @relation(fields: [billingPaymentId], references: [id], onDelete: SetNull)
  @@unique([provider, providerEventId], map: "BillingWebhookEvent_provider_event_unique")
  @@index([createdAt])
}
model BillingOperationsHeartbeat {
  id String @id
  lastSucceededAt DateTime
  releaseSha String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model AnalyticsEvent {
  id String @id @default(uuid())
  businessId String
  eventType String
  metadata Json?
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@index([businessId])
  @@index([eventType])
  @@index([createdAt])
}
model Branch {
  id String @id @default(uuid())
  businessId String
  name String
  city String?
  district String?
  address String?
  phone String?
  whatsapp String?
  googleMapsLink String?
  isMain Boolean @default(false)
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  contacts ContactPerson[]
  @@index([businessId])
  @@index([isActive])
  @@index([sortOrder])
}
model Department {
  id String @id @default(uuid())
  businessId String
  name String
  description String?
  icon String?
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  contacts ContactPerson[]
  @@index([businessId])
  @@index([isActive])
  @@index([sortOrder])
}
model ContactPerson {
  id String @id @default(uuid())
  businessId String
  departmentId String?
  branchId String?
  name String
  jobTitle String?
  phone String?
  whatsapp String?
  email String?
  imageUrl String?
  isPrimary Boolean @default(false)
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  @@index([businessId])
  @@index([departmentId])
  @@index([branchId])
  @@index([isActive])
  @@index([sortOrder])
}
model StoredObject {
  id String @id @default(uuid())
  objectKey String @unique
  folder String
  fileName String
  mimeType String
  size Int
  storageDriver String @default("database")
  data Bytes?
  createdAt DateTime @default(now())
  @@index([folder])
  @@index([storageDriver])
  @@index([createdAt])
}