generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())
  name String
  email String @unique
  passwordHash String?
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  sessions Session[]
  businesses Business[]
  authIdentities AuthIdentity[]
  @@index([email])
  @@index([emailVerifiedAt])
  @@index([deletedAt])
}
model AuthIdentity {
  id String @id @default(uuid())
  userId String
  provider String
  providerSubject String
  providerEmail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerSubject])
  @@index([userId])
  @@index([providerEmail])
}
model OAuthState {
  id String @id @default(uuid())
  state String @unique
  provider String
  nonce String
  codeVerifier String?
  redirectTo String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([provider])
  @@index([expiresAt])
}
model Session {
  id String @id @default(uuid())
  token String @unique
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}
model BusinessPlan {
  id String @id @default(uuid())
  code String @unique
  name String
  monthlyPrice Int
  productLimit Int
  aiEnabled Boolean @default(false)
  onlinePay Boolean @default(false)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  businesses Business[]
  subscriptions Subscription[]
  billingPayments BillingPayment[]
}
model Business {
  id String @id @default(uuid())
  ownerId String
  planId String?
  name String
  slug String @unique
  businessType String
  shortDescription String?
  description String?
  logoUrl String?
  coverImageUrl String?
  primaryColor String? @default("#2563EB")
  secondaryColor String?
  phone String?
  whatsapp String?
  email String?
  website String?
  address String?
  city String?
  district String?
  googleMapsLink String?
  latitude Float?
  longitude Float?
  isPublished Boolean @default(false)
  isVerified Boolean @default(false)
  verificationBadge String?
  theme String? @default("default")
  template String? @default("modern")
  customDomain String?
  onboardingStep Int @default(1)
  onboardingCompleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  plan BusinessPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  products Product[]
  services Service[]
  pageModules PageModule[]
  operatingHours OperatingHours[]
  galleryItems GalleryItem[]
  socialLinks SocialLink[]
  subscriptions Subscription[]
  billingPaymentMethods BillingPaymentMethod[]
  billingPayments BillingPayment[]
  branches Branch[]
  departments Department[]
  contacts ContactPerson[]
  customers Customer[]
  orders Order[]
  bookings Booking[]
  analyticsEvents AnalyticsEvent[]
  adminRequests AdminRequest[]
  slugAliases BusinessSlugAlias[]
  @@index([ownerId])
  @@index([planId])
  @@index([isPublished])
  @@index([deletedAt])
}
model BusinessSlugAlias {
  id String @id @default(uuid())
  businessId String
  slug String @unique
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@index([businessId])
}
model Product {
  id String @id @default(uuid())
  businessId String
  name String
  description String?
  price Int
  compareAtPrice Int?
  sku String?
  unit String?
  imageUrl String?
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  @@index([businessId])
  @@index([isActive])
  @@index([sortOrder])
}
model Service {
  id String @id @default(uuid())
  businessId String
  name String
  description String?
  price Int?
  durationMinutes Int?
  imageUrl String?
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  bookings Booking[]
  @@index([businessId])
  @@index([isActive])
  @@index([sortOrder])
}
model PageModule {
  id String @id @default(uuid())
  businessId String
  type String
  title String?
  content Json?
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@index([businessId])
  @@index([sortOrder])
  @@index([isActive])
}
model OperatingHours {
  id String @id @default(uuid())
  businessId String
  dayOfWeek Int
  opensAt String?
  closesAt String?
  secondOpensAt String?
  secondClosesAt String?
  isClosed Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@unique([businessId, dayOfWeek])
  @@index([businessId])
  @@index([dayOfWeek])
}
model GalleryItem {
  id String @id @default(uuid())
  businessId String
  imageUrl String
  caption String?
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@index([businessId])
  @@index([sortOrder])
  @@index([isActive])
}
model SocialLink {
  id String @id @default(uuid())
  businessId String
  platform String
  url String
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@unique([businessId, platform])
  @@index([businessId])
  @@index([sortOrder])
  @@index([isActive])
}
model Subscription {
  id String @id @default(uuid())
  businessId String
  planId String
  status String @default("active")
  provider String?
  providerCustomerId String?
  providerSubscriptionId String?
  autoRenew Boolean @default(false)
  providerReference String?
  paymentMethodId String?
  startsAt DateTime @default(now())
  endsAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  plan BusinessPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  paymentMethod BillingPaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  billingPayments BillingPayment[]
  @@index([businessId])
  @@index([planId])
  @@index([status])
  @@index([paymentMethodId])
}
model BillingPaymentMethod {
  id String @id @default(uuid())
  businessId String
  provider String @default("moyasar")
  encryptedToken String
  brand String?
  last4 String?
  status String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]
  @@index([businessId])
}
model BillingPayment {
  id String @id @default(uuid())
  businessId String
  planId String
  subscriptionId String?
  provider String @default("moyasar")
  providerPaymentId String? @unique(map: "BillingPayment_provider_payment_unique")
  providerGivenId String @unique(map: "BillingPayment_provider_given_unique")
  kind String @default("initial")
  amount Int
  currency String @default("SAR")
  status String @default("created")
  attempt Int @default(1)
  nextRetryAt DateTime?
  paidAt DateTime?
  receiptSellerLegalName String?
  receiptSellerAddress String?
  receiptTaxStatus String?
  receiptNetAmount Int?
  receiptVatAmount Int?
  receiptIssuedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  plan BusinessPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  webhookEvents BillingWebhookEvent[]
  @@index([businessId, createdAt])
  @@index([status, nextRetryAt])
}
model BillingWebhookEvent {
  id String @id @default(uuid())
  provider String @default("moyasar")
  providerEventId String
  eventType String
  billingPaymentId String?
  providerPaymentId String?
  processingStartedAt DateTime?
  nextAttemptAt DateTime?
  attempts Int @default(0)
  lastError String?
  createdAt DateTime @default(now())
  processedAt DateTime?
  billingPayment BillingPayment? @relation(fields: [billingPaymentId], references: [id], onDelete: SetNull)
  @@unique([provider, providerEventId], map: "BillingWebhookEvent_provider_event_unique")
  @@index([createdAt])
}
model BillingOperationsHeartbeat {
  id String @id
  lastSucceededAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model AnalyticsEvent {
  id String @id @default(uuid())
  businessId String
  eventType String
  metadata Json?
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@index([businessId])
  @@index([eventType])
  @@index([createdAt])
}
model Branch {
  id String @id @default(uuid())
  businessId String
  name String
  city String?
  district String?
  address String?
  phone String?
  whatsapp String?
  googleMapsLink String?
  isMain Boolean @default(false)
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  contacts ContactPerson[]
  @@index([businessId])
  @@index([isActive])
  @@index([sortOrder])
}
model Department {
  id String @id @default(uuid())
  businessId String
  name String
  description String?
  icon String?
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  contacts ContactPerson[]
  @@index([businessId])
  @@index([isActive])
  @@index([sortOrder])
}
model ContactPerson {
  id String @id @default(uuid())
  businessId String
  branchId String?
  departmentId String?
  name String
  title String?
  phone String?
  whatsapp String?
  email String?
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  @@index([businessId])
  @@index([branchId])
  @@index([departmentId])
  @@index([isActive])
  @@index([sortOrder])
}
model Customer {
  id String @id @default(uuid())
  businessId String
  name String
  phone String
  email String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  orders Order[]
  bookings Booking[]
  @@index([businessId])
  @@index([phone])
}
model Order {
  id String @id @default(uuid())
  businessId String
  customerId String?
  status String @default("new")
  totalAmount Int
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items OrderItem[]
  @@index([businessId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}
model OrderItem {
  id String @id @default(uuid())
  orderId String
  productId String?
  productName String
  quantity Int
  unitPrice Int
  lineTotal Int
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([orderId])
  @@index([productId])
}
model Booking {
  id String @id @default(uuid())
  businessId String
  customerId String?
  serviceId String?
  bookingDate String
  bookingTime String
  status String @default("pending")
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  @@index([businessId])
  @@index([customerId])
  @@index([serviceId])
  @@index([bookingDate])
  @@index([status])
}
model AdminRequest {
  id String @id @default(uuid())
  businessId String
  type String
  status String @default("pending")
  notes String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@index([businessId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}
model AnalyticsEvent {
  id String @id @default(uuid())
  businessId String
  eventType String
  metadata Json?
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@index([businessId])
  @@index([eventType])
  @@index([createdAt])
}
