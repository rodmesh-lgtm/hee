// Staged schema fragment for Round 157. This is intentionally separate until merged into
// schema.prisma in the same round after migration guards pass; it is not loaded by Prisma.
model WhatsAppConversation {
  id String @id @default(uuid())
  businessId String
  phoneNumberId String
  customerPhoneE164 String
  customerDisplayName String?
  lastMessageAt DateTime?
  lastInboundAt DateTime?
  lastOutboundAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  messages WhatsAppMessage[]
  @@unique([businessId, phoneNumberId, customerPhoneE164], map: "WhatsAppConversation_tenant_phone_unique")
  @@unique([id, businessId], map: "WhatsAppConversation_id_business_unique")
  @@index([businessId, lastMessageAt], map: "WhatsAppConversation_business_last_message_idx")
}

model WhatsAppMessage {
  id String @id @default(uuid())
  businessId String
  conversationId String
  provider String @default("meta")
  providerMessageId String
  direction String
  messageType String
  status String
  textBody String?
  payload Json?
  errorCode String?
  errorMessage String?
  providerTimestamp DateTime?
  sentAt DateTime?
  deliveredAt DateTime?
  readAt DateTime?
  failedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  conversation WhatsAppConversation @relation(fields: [conversationId, businessId], references: [id, businessId], onDelete: Restrict)
  @@unique([provider, providerMessageId], map: "WhatsAppMessage_provider_message_unique")
  @@index([businessId, createdAt], map: "WhatsAppMessage_business_created_idx")
  @@index([conversationId, createdAt], map: "WhatsAppMessage_conversation_created_idx")
  @@index([businessId, status, createdAt], map: "WhatsAppMessage_business_status_idx")
}
