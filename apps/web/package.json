{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/sync-rc-preview-schema.mjs && node scripts/assert-rc-preview-schema-current.mjs && rm -rf .next && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "rm -rf .next && prisma generate && next typegen && tsc --noEmit --pretty false",
    "test": "npm run test:unit",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:rc": "playwright test tests/launch-customer-journey.spec.ts tests/rc-owner-workflow.spec.ts tests/active-business-isolation.spec.ts tests/digital-identity-workflow.spec.ts tests/dashboard-functional-workflow.spec.ts tests/business-store-workflow.spec.ts",
    "test:admin": "playwright test tests/admin-workflow.spec.ts tests/admin-requests-workflow.spec.ts tests/support-data-rights-workflow.spec.ts tests/admin-access-code-workflow.spec.ts tests/admin-business-store-catalog-workflow.spec.ts tests/admin-business-store-orders-workflow.spec.ts tests/admin-billing-operations-workflow.spec.ts tests/admin-customer-accounts-workflow.spec.ts",
    "test:directory": "playwright test tests/directory-workflow.spec.ts",
    "test:transactions": "playwright test tests/transactions-workflow.spec.ts tests/booking-duration-workflow.spec.ts tests/public-idempotency-workflow.spec.ts",
    "test:email-verification": "playwright test tests/email-verification-workflow.spec.ts tests/unverified-email-change-workflow.spec.ts",
    "qa:handoff": "tsx scripts/generate-qa-handoff.ts",
    "storage:audit": "tsx scripts/storage-audit.ts",
    "storage:sweep": "tsx scripts/storage-audit.ts --delete",
    "data:retention-audit": "tsx scripts/data-retention-audit.ts",
    "retention:dry-run": "tsx scripts/prune-expired-operational-data.ts",
    "retention:apply": "tsx scripts/prune-expired-operational-data.ts --apply",
    "public:transactions-audit": "tsx scripts/public-transactions-audit.ts",
    "billing:integrity-audit": "tsx scripts/billing-integrity-audit.ts",
    "billing:state-audit": "tsx scripts/billing-state-audit.ts",
    "backup:audit-seed": "tsx scripts/backup-restore-audit.ts",
    "backup:audit-verify": "tsx scripts/backup-restore-audit.ts --verify",
    "backup:production-proof": "tsx scripts/production-backup-restore-proof.ts",
    "migration:production-data-proof": "tsx scripts/production-migration-data-proof.ts",
    "launch:config-audit": "tsx scripts/launch-config-audit.ts",
    "billing:webhooks": "NODE_OPTIONS=--conditions=react-server tsx scripts/billing-webhook-recovery-worker.ts",
    "billing:renew-only": "tsx scripts/billing-renewal-worker.ts",
    "billing:renew": "npm run billing:webhooks && npm run billing:renew-only && npm run billing:state-audit -- --record-heartbeat",
    "whatsapp:webhooks": "NODE_OPTIONS=--conditions=react-server tsx scripts/whatsapp-webhook-worker.ts",
    "whatsapp:shopify-webhooks": "NODE_OPTIONS=--conditions=react-server tsx scripts/whatsapp-shopify-webhook-worker.ts",
    "whatsapp:shopify-abandoned-carts": "NODE_OPTIONS=--conditions=react-server tsx scripts/whatsapp-shopify-abandoned-cart-worker.ts",
    "whatsapp:shopify-subscriptions": "NODE_OPTIONS=--conditions=react-server tsx scripts/whatsapp-shopify-subscription-worker.ts",
    "whatsapp:deliveries": "NODE_OPTIONS=--conditions=react-server tsx scripts/whatsapp-delivery-worker.ts",
    "whatsapp:campaigns": "NODE_OPTIONS=--conditions=react-server tsx scripts/whatsapp-campaign-scheduler.ts",
    "whatsapp:replies": "NODE_OPTIONS=--conditions=react-server tsx scripts/whatsapp-reply-worker.ts",
    "whatsapp:automation-schedules": "NODE_OPTIONS=--conditions=react-server tsx scripts/whatsapp-automation-scheduler.ts",
    "whatsapp:automations": "NODE_OPTIONS=--conditions=react-server tsx scripts/whatsapp-automation-worker.ts",
    "whatsapp:automation-deliveries": "NODE_OPTIONS=--conditions=react-server tsx scripts/whatsapp-automation-delivery-worker.ts",
    "whatsapp:contact-imports": "NODE_OPTIONS=--conditions=react-server tsx scripts/whatsapp-contact-import-worker.ts",
    "whatsapp:operations": "NODE_OPTIONS=--conditions=react-server tsx scripts/whatsapp-operations-worker.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "prisma@5.22.0": true,
    "unrs-resolver@1.12.2": true
  },
  "dependencies": {
    "@prisma/adapter-pg": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.43.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "read-excel-file": "9.3.10",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}
