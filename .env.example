APP_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
DATABASE_URL=postgresql://hee:change-this-locally@localhost:5432/hee
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-me

# Billing. "mock" is strictly for CI/development. Production paid launch uses Moyasar.
# Never commit live keys. The same variables work on Vercel and later on Hetzner VPS.
PAYMENT_PROVIDER=mock
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
# Create a Moyasar webhook for: https://hee.sa/api/billing/moyasar/webhook
# Configure a strong shared_secret in Moyasar and place the same value here.
MOYASAR_WEBHOOK_SECRET=
# 32 random bytes encoded as base64. Used with AES-256-GCM for recurring-payment tokens.
# Example generation: openssl rand -base64 32
BILLING_TOKEN_ENCRYPTION_KEY=
# Keep recurring charges disabled until live merchant keys, webhook delivery and a test
# renewal have all been verified. The Hetzner worker/cron will require this to be true.
BILLING_RENEWAL_ENABLED=false

# Canonical public application origin. Set both to https://hee.sa in production.
AUTH_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional email used for mandatory mailbox verification before publication.
# Production launch is not complete until the sending domain is verified with the
# provider and both values are configured in the Production environment.
RESEND_API_KEY=
HEE_FROM_EMAIL=HEE <no-reply@hee.sa>

# Social sign-in. Keep secrets only in the deployment environment, never in Git.
# Google callback: <AUTH_ORIGIN>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple callback: <AUTH_ORIGIN>/api/auth/oauth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM content may be stored with literal \n sequences by the deployment provider.
APPLE_PRIVATE_KEY=

# Persistent uploads
UPLOAD_MAX_BYTES=5242880
COMPANY_PROFILE_MAX_BYTES=5242880
# Orphan cleanup is intentionally conservative. Seven days is the default minimum
# review window; billing/subscription state must never trigger storage deletion.
STORAGE_ORPHAN_GRACE_HOURS=168
# Destructive sweeps remain disabled unless explicitly enabled for a reviewed run.
ALLOW_STORAGE_ORPHAN_DELETE=false

# Persistent driver: database or s3. This remains portable to Hetzner.
STORAGE_DRIVER=database

# S3-compatible storage (Hetzner Object Storage, MinIO, etc.). Required only when STORAGE_DRIVER=s3.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Most S3-compatible providers use path-style requests. Set false only when virtual-host style is required.
S3_FORCE_PATH_STYLE=true
# Development-only escape hatch. Keep false/empty in production so S3_ENDPOINT must use HTTPS.
S3_ALLOW_INSECURE=false

# Preview-only QA audit access. Do not configure these in production.
QA_AUDIT_SECRET=
QA_AUDIT_USER_EMAIL=
QA_AUDIT_USER_NAME=QA Audit Preview
