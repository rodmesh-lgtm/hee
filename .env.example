APP_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
DATABASE_URL=postgresql://hee:change-this-locally@localhost:5432/hee
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-me
PAYMENT_PROVIDER=mock

# Persistent uploads
UPLOAD_MAX_BYTES=5242880
COMPANY_PROFILE_MAX_BYTES=5242880
STORAGE_ORPHAN_GRACE_HOURS=24
# Destructive sweeps remain disabled unless explicitly enabled for a reviewed run.
ALLOW_STORAGE_ORPHAN_DELETE=false

# Current persistent driver. Application code talks only to StorageAdapter so this can
# later switch to an S3-compatible backend (for example Hetzner Object Storage/MinIO)
# without changing business/page-builder code.
STORAGE_DRIVER=database
# Reserved for the upcoming S3-compatible adapter:
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
